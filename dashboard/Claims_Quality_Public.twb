<?xml version='1.0' encoding='utf-8'?>
<workbook version="18.1" source-platform="mac" source-build="2026.2.2 (20262.26.0819.2015)">
  <preferences />
  <datasources>
    <datasource name="claims" caption="Reconciled synthetic claims" inline="true" version="18.1">
      <connection directory="Data" filename="dashboard.csv" server="" class="textscan">
        <relation name="dashboard.csv" table="[dashboard#csv]" type="table">
          <columns header="yes" separator="," locale="en_US" character-set="UTF-8">
            <column name="panel" datatype="string" ordinal="0" />
            <column name="label" datatype="string" ordinal="1" />
            <column name="value" datatype="real" ordinal="2" />
            <column name="unit" datatype="string" ordinal="3" />
          </columns>
        </relation>
      </connection>
      <aliases enabled="yes" />
      <column name="[panel]" datatype="string" role="dimension" type="nominal" />
      <column name="[label]" datatype="string" role="dimension" type="nominal" />
      <column name="[value]" datatype="real" role="measure" type="quantitative" />
      <column name="[unit]" datatype="string" role="dimension" type="nominal" />
      <extract enabled="true" count="-1" units="records">
        <connection class="hyper" dbname="Data/dashboard.hyper" schema="Extract" access_mode="readonly" authentication="auth-none" default-settings="yes">
          <relation name="Extract" table="[Extract].[Extract]" type="table" />
        </connection>
      </extract>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Reconciliation — USD">
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize="12" bold="true">Reconciliation — USD</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name="claims" caption="Reconciled synthetic claims" />
          </datasources>
          <datasource-dependencies datasource="claims">
            <column name="[panel]" datatype="string" role="dimension" type="nominal" />
            <column name="[label]" datatype="string" role="dimension" type="nominal" caption="Category" />
            <column name="[value]" datatype="real" role="measure" type="quantitative" />
            <column name="[unit]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[panel]" derivation="None" name="[none:panel:nk]" pivot="key" type="nominal" />
            <column-instance column="[label]" derivation="None" name="[none:label:nk]" pivot="key" type="nominal" />
            <column-instance column="[value]" derivation="Sum" name="[sum:value:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter column="[claims].[none:panel:nk]" class="categorical">
            <groupfilter function="member" level="[none:panel:nk]" member="&quot;Reconciliation&quot;" />
          </filter>
          <slices>
            <column>[claims].[none:panel:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="mark">
            <format attr="mark-labels-show" value="true" />
          </style-rule>
          <style-rule element="axis">
            <format attr="title" field="[claims].[sum:value:qk]" scope="cols" value="Paid amount (USD)" class="0" />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings />
          </pane>
        </panes>
        <rows>[claims].[none:label:nk]</rows>
        <cols>[claims].[sum:value:qk]</cols>
      </table>
    </worksheet>
